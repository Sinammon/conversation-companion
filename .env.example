# Optional. Leave blank for a captions-only notebook.
EXPO_PUBLIC_AI_URL=
# Service listens only on this computer by default.
HOST=127.0.0.1
PORT=8787
# Private server credential from Google AI Studio. Do not use EXPO_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Add the exact Expo LAN origin for phone browsers on the same Wi-Fi.
WEB_ORIGINS=http://localhost:8081
