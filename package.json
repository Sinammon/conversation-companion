{
  "name": "conversation-companion",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test": "tsx --test tests/*.test.*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-speech-recognition": "58.0.1",
    "expo-sqlite": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
